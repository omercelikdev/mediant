<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Turns on the trimming + Native AOT analyzers. A clean build proves the generated
         registration + dispatch path contains no AOT-incompatible calls. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Qorpe.Mediator/Qorpe.Mediator.csproj" />
    <ProjectReference Include="../../src/Qorpe.Mediator.SourceGenerator/Qorpe.Mediator.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
