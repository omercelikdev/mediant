<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Turns on the trimming + Native AOT analyzers. A clean build proves the generated
         registration + dispatch path contains no AOT-incompatible calls. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Set here (not on the command line) so the property does not flow to the netstandard2.0
         source-generator project reference, which cannot be AOT-published (NETSDK1207).
         Only honored during 'dotnet publish'; ignored by 'dotnet build'/'dotnet test'. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mediant/Mediant.csproj" />
    <ProjectReference Include="../../src/Mediant.SourceGenerator/Mediant.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" UndefineProperties="PublishAot" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

</Project>
